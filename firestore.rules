rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core security primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && isVerified() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && isVerified() && (
        request.auth.token.email == 'gerinaicker04@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity validation blueprints
    function isValidLeaderboardPlayer(data) {
      return data.keys().hasAll(['uid', 'username', 'coins', 'weeklyCoins', 'qualified', 'streakCount', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'trackingId', 'username', 'coins', 'weeklyCoins', 'qualified', 'streakCount', 'sundayBonusZar', 'isPublic', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && (!('trackingId' in data) || (data.trackingId is string && data.trackingId.size() >= 1 && data.trackingId.size() <= 128 && data.trackingId.matches('^[a-zA-Z0-9_\\-]+$')))
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 32
        && data.coins is number && data.coins >= 0 && data.coins <= 100000000
        && data.weeklyCoins is number && data.weeklyCoins >= 0 && data.weeklyCoins <= 100000000
        && data.qualified is bool
        && data.streakCount is number && data.streakCount >= 0 && data.streakCount <= 7
        && (!('sundayBonusZar' in data) || (data.sundayBonusZar is number && data.sundayBonusZar >= 0 && data.sundayBonusZar <= 1000000))
        && data.isPublic is bool && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlayerPrivate(data) {
      return data.keys().hasAll(['uid', 'contact', 'dailyGiftLastClaimed', 'weekKey', 'claimedDays', 'watchedEpisodeIds', 'lastKeepWatchingDate', 'lastBannerClaimAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'trackingId', 'contact', 'dailyGiftLastClaimed', 'weekKey', 'claimedDays', 'watchedEpisodeIds', 'lastKeepWatchingDate', 'lastBannerClaimAt', 'lastActivityDate', 'lastMysteryPickDate', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && (!('trackingId' in data) || (data.trackingId is string && data.trackingId.size() >= 1 && data.trackingId.size() <= 128 && data.trackingId.matches('^[a-zA-Z0-9_\\-]+$')))
        && data.contact is string && data.contact.size() >= 4 && data.contact.size() <= 120
        && data.dailyGiftLastClaimed is string && data.dailyGiftLastClaimed.size() <= 16
        && data.weekKey is string && data.weekKey.size() <= 16
        && data.claimedDays is list && data.claimedDays.size() <= 7 && (data.claimedDays.size() == 0 || data.claimedDays[0] is string)
        && data.watchedEpisodeIds is list && data.watchedEpisodeIds.size() <= 100 && (data.watchedEpisodeIds.size() == 0 || data.watchedEpisodeIds[0] is string)
        && data.lastKeepWatchingDate is string && data.lastKeepWatchingDate.size() <= 16
        && data.lastBannerClaimAt is number && data.lastBannerClaimAt >= 0
        && (!('lastActivityDate' in data) || (data.lastActivityDate is string && data.lastActivityDate.size() <= 16))
        && (!('lastMysteryPickDate' in data) || (data.lastMysteryPickDate is string && data.lastMysteryPickDate.size() <= 16))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSeries(data) {
      return data.keys().hasAll(['seriesId', 'title', 'category', 'coverImage', 'synopsis', 'episodeIds', 'sortOrder', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['seriesId', 'title', 'category', 'posterUrl', 'coverImage', 'synopsis', 'episodeIds', 'sortOrder', 'isPublic', 'createdAt', 'updatedAt'])
        && data.seriesId is string && data.seriesId.size() >= 1 && data.seriesId.size() <= 80 && data.seriesId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 60
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 32
        && (!('posterUrl' in data) || (data.posterUrl is string && data.posterUrl.size() <= 2000))
        && data.coverImage is string && data.coverImage.size() >= 1 && data.coverImage.size() <= 2000
        && data.synopsis is string && data.synopsis.size() >= 1 && data.synopsis.size() <= 240
        && data.episodeIds is list && data.episodeIds.size() <= 100 && (data.episodeIds.size() == 0 || data.episodeIds[0] is string)
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000
        && data.isPublic is bool && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEpisode(data) {
      return data.keys().hasAll(['title', 'series', 'episodeLabel', 'duration', 'rewardCoins', 'coverImage', 'synopsis', 'sponsorUrl', 'sortOrder', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'series', 'seriesId', 'category', 'episodeLabel', 'duration', 'rewardCoins', 'posterUrl', 'coverImage', 'synopsis', 'sponsorUrl', 'youtubeUrl', 'startTime', 'sortOrder', 'isPublic', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.series is string && data.series.size() >= 1 && data.series.size() <= 60
        && (!('seriesId' in data) || (data.seriesId is string && data.seriesId.size() >= 1 && data.seriesId.size() <= 80))
        && (!('category' in data) || (data.category is string && data.category.size() >= 1 && data.category.size() <= 32))
        && data.episodeLabel is string && data.episodeLabel.size() >= 1 && data.episodeLabel.size() <= 24
        && data.duration is string && data.duration.size() >= 1 && data.duration.size() <= 16
        && data.rewardCoins is number && data.rewardCoins >= 1 && data.rewardCoins <= 5000
        && (!('posterUrl' in data) || (data.posterUrl is string && data.posterUrl.size() <= 2000))
        && data.coverImage is string && data.coverImage.size() >= 1 && data.coverImage.size() <= 2000
        && data.synopsis is string && data.synopsis.size() >= 1 && data.synopsis.size() <= 240
        && data.sponsorUrl is string && data.sponsorUrl.size() <= 500
        && (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 500))
        && (!('startTime' in data) || (data.startTime is number && data.startTime >= 0 && data.startTime <= 86400))
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000
        && data.isPublic is bool && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAppConfig(data) {
      return data.keys().hasAll(['sponsorAdUrl', 'poolPrizeZar', 'poolTargetCoins', 'qualificationThreshold', 'episodesSeeded', 'isPublic', 'updatedAt'])
        && data.keys().hasOnly([
          'sponsorAdUrl',
          'embeddedAdHtml',
          'poolPrizeZar',
          'rolloverAmountZar',
          'poolWeekKey',
          'weekStartTimestamp',
          'lastPoolWinnerSummary',
          'lastWinnerUids',
          'mysteryWinningBoxes',
          'r5WinnerUsername',
          'nextPickWinsR5',
          'liveTickerEnabled',
          'liveTickerNames',
          'poolTargetCoins',
          'qualificationThreshold',
          'episodesSeeded',
          'isPublic',
          'updatedAt'
        ])
        && data.sponsorAdUrl is string && data.sponsorAdUrl.size() >= 8 && data.sponsorAdUrl.size() <= 500
        && (!('embeddedAdHtml' in data) || (data.embeddedAdHtml is string && data.embeddedAdHtml.size() <= 8000))
        && data.poolPrizeZar is number && data.poolPrizeZar >= 0 && data.poolPrizeZar <= 1000000
        && (!('rolloverAmountZar' in data) || (data.rolloverAmountZar is number && data.rolloverAmountZar >= 0 && data.rolloverAmountZar <= 1000000))
        && (!('poolWeekKey' in data) || (data.poolWeekKey is string && data.poolWeekKey.size() <= 16))
        && (!('weekStartTimestamp' in data) || (data.weekStartTimestamp is number && data.weekStartTimestamp >= 0))
        && (!('lastPoolWinnerSummary' in data) || (data.lastPoolWinnerSummary is string && data.lastPoolWinnerSummary.size() <= 300))
        && (!('lastWinnerUids' in data) || (data.lastWinnerUids is list && data.lastWinnerUids.size() <= 3 && (data.lastWinnerUids.size() == 0 || data.lastWinnerUids[0] is string)))
        && (!('mysteryWinningBoxes' in data) || (data.mysteryWinningBoxes is number && data.mysteryWinningBoxes >= 0 && data.mysteryWinningBoxes <= 12))
        && (!('r5WinnerUsername' in data) || (data.r5WinnerUsername is string && data.r5WinnerUsername.size() <= 32))
        && (!('nextPickWinsR5' in data) || (data.nextPickWinsR5 is bool))
        && (!('liveTickerEnabled' in data) || (data.liveTickerEnabled is bool))
        && (!('liveTickerNames' in data) || (data.liveTickerNames is list && data.liveTickerNames.size() <= 20 && (data.liveTickerNames.size() == 0 || data.liveTickerNames[0] is string)))
        && data.poolTargetCoins is number && data.poolTargetCoins >= 100 && data.poolTargetCoins <= 100000000
        && data.qualificationThreshold is number && data.qualificationThreshold >= 0 && data.qualificationThreshold <= 1000000
        && data.episodesSeeded is bool
        && data.isPublic is bool && data.isPublic == true
        && data.updatedAt is timestamp;
    }

    function isValidMysteryWinner(data) {
      return data.keys().hasAll(['uid', 'username', 'contact', 'voucherCode', 'amountZar', 'boxNumber', 'createdAt'])
        && data.keys().hasOnly(['uid', 'username', 'contact', 'voucherCode', 'amountZar', 'boxNumber', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 32
        && data.contact is string && data.contact.size() >= 4 && data.contact.size() <= 120
        && data.voucherCode is string && data.voucherCode.size() >= 4 && data.voucherCode.size() <= 32
        && data.amountZar is number && (data.amountZar == 3 || data.amountZar == 5)
        && data.boxNumber is number && data.boxNumber >= 1 && data.boxNumber <= 12
        && data.createdAt is timestamp;
    }

    function isValidPrizeWin(data) {
      return data.keys().hasAll(['uid', 'createdByUid', 'username', 'prizeType', 'amountZar', 'coinsAwarded', 'summary', 'status', 'createdAt'])
        && data.keys().hasOnly(['uid', 'createdByUid', 'username', 'contact', 'prizeType', 'amountZar', 'coinsAwarded', 'voucherCode', 'boxNumber', 'rank', 'weekKey', 'summary', 'status', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 && data.createdByUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 32
        && (!('contact' in data) || (data.contact is string && data.contact.size() <= 120))
        && data.prizeType in ['sunday_pool', 'mystery_r3_boost', 'mystery_11th_jackpot']
        && data.amountZar is number && data.amountZar >= 0 && data.amountZar <= 1000000
        && data.coinsAwarded is number && data.coinsAwarded >= 0 && data.coinsAwarded <= 1000000
        && (!('voucherCode' in data) || (data.voucherCode is string && data.voucherCode.size() <= 40))
        && (!('boxNumber' in data) || (data.boxNumber is number && data.boxNumber >= 0 && data.boxNumber <= 12))
        && (!('rank' in data) || (data.rank is number && data.rank >= 0 && data.rank <= 10))
        && (!('weekKey' in data) || (data.weekKey is string && data.weekKey.size() <= 16))
        && data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 300
        && data.status in ['recorded', 'paid']
        && data.createdAt is timestamp;
    }

    function isValidSupportMessage(data) {
      return data.keys().hasAll(['uid', 'username', 'contact', 'category', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'username', 'contact', 'category', 'subject', 'message', 'status', 'adminNote', 'resolvedBy', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 40
        && data.contact is string && data.contact.size() >= 2 && data.contact.size() <= 120
        && data.category in ['claim_prize', 'coins', 'mystery_box', 'sunday_pool', 'feedback', 'other']
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 120
        && data.message is string && data.message.size() >= 2 && data.message.size() <= 2000
        && data.status in ['open', 'resolved']
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 500))
        && (!('resolvedBy' in data) || (data.resolvedBy is string && data.resolvedBy.size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMailNotification(data) {
      return data.keys().hasAll(['uid', 'to', 'eventType', 'message', 'createdAt'])
        && data.keys().hasOnly(['uid', 'to', 'eventType', 'message', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.to is list && data.to.size() == 1 && data.to[0] == 'gerinaicker04@gmail.com'
        && data.eventType in ['prize_win', 'support_message']
        && data.message is map
        && data.message.keys().hasAll(['subject', 'text', 'html'])
        && data.message.keys().hasOnly(['subject', 'text', 'html'])
        && data.message.subject is string && data.message.subject.size() >= 2 && data.message.subject.size() <= 200
        && data.message.text is string && data.message.text.size() >= 2 && data.message.text.size() <= 5000
        && data.message.html is string && data.message.html.size() >= 2 && data.message.html.size() <= 10000
        && data.createdAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['role', 'passcode', 'createdAt'])
        && data.keys().hasOnly(['role', 'passcode', 'createdAt'])
        && data.role == 'admin'
        && data.passcode is string && data.passcode.size() >= 1 && data.passcode.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidCoinTransaction(data) {
      return data.keys().hasAll(['uid', 'type', 'category', 'title', 'amount', 'balanceAfter', 'createdAt'])
        && data.keys().hasOnly(['uid', 'type', 'category', 'title', 'amount', 'balanceAfter', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.type in ['earn', 'spend', 'adjustment']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 32
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.amount is number && data.amount >= -100000000 && data.amount <= 100000000
        && data.balanceAfter is number && data.balanceAfter >= 0 && data.balanceAfter <= 100000000
        && data.createdAt is timestamp;
    }

    function isValidReferral(data) {
      return data.keys().hasAll(['visitorUid', 'referrerUid', 'status', 'rewardCoins', 'createdAt'])
        && data.keys().hasOnly(['visitorUid', 'referrerUid', 'status', 'rewardCoins', 'createdAt', 'claimedAt'])
        && data.visitorUid is string && data.visitorUid.size() >= 1 && data.visitorUid.size() <= 128 && data.visitorUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.referrerUid is string && data.referrerUid.size() >= 1 && data.referrerUid.size() <= 128 && data.referrerUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.status in ['pending', 'claimed']
        && data.rewardCoins is number && data.rewardCoins == 1000
        && data.createdAt is timestamp
        && (!('claimedAt' in data) || data.claimedAt is timestamp);
    }

    function isValidWatchPartyRoom(data) {
      return data.keys().hasAll(['roomId', 'hostUid', 'hostName', 'episodeId', 'episodeTitle', 'seriesTitle', 'episodeLabel', 'category', 'dailymotionId', 'videoUrl', 'isPlaying', 'currentTime', 'playbackUpdatedAtMs', 'status', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['roomId', 'hostUid', 'hostName', 'episodeId', 'episodeTitle', 'seriesTitle', 'episodeLabel', 'category', 'dailymotionId', 'videoUrl', 'coverImage', 'archiveIdentifier', 'isPlaying', 'currentTime', 'playbackUpdatedAtMs', 'status', 'isPublic', 'isPrivate', 'maxCapacity', 'viewerCount', 'createdAt', 'updatedAt'])
        && data.roomId is string && data.roomId.size() >= 4 && data.roomId.size() <= 64 && data.roomId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 && data.hostUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.hostName is string && data.hostName.size() >= 2 && data.hostName.size() <= 32
        && data.episodeId is string && data.episodeId.size() >= 1 && data.episodeId.size() <= 128
        && data.episodeTitle is string && data.episodeTitle.size() >= 1 && data.episodeTitle.size() <= 120
        && data.seriesTitle is string && data.seriesTitle.size() >= 1 && data.seriesTitle.size() <= 80
        && data.episodeLabel is string && data.episodeLabel.size() >= 1 && data.episodeLabel.size() <= 32
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 32
        && data.dailymotionId is string && data.dailymotionId.size() <= 32
        && data.videoUrl is string && data.videoUrl.size() >= 1 && data.videoUrl.size() <= 500
        && (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 2000))
        && (!('archiveIdentifier' in data) || (data.archiveIdentifier is string && data.archiveIdentifier.size() <= 128))
        && data.isPlaying is bool
        && data.currentTime is number && data.currentTime >= 0 && data.currentTime <= 86400
        && data.playbackUpdatedAtMs is number && data.playbackUpdatedAtMs >= 0
        && data.status in ['active', 'ended']
        && data.isPublic is bool
        && (!('isPrivate' in data) || (data.isPrivate is bool && data.isPrivate == !data.isPublic))
        && (!('maxCapacity' in data) || (data.maxCapacity is number && ((data.isPublic == true && data.maxCapacity == 25) || (data.isPublic == false && data.maxCapacity == 8))))
        && (!('viewerCount' in data) || (data.viewerCount is number && data.viewerCount >= 1 && data.viewerCount <= 25))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWatchPartyParticipant(data) {
      return data.keys().hasAll(['roomId', 'uid', 'username', 'role', 'lastSeenMs', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly(['roomId', 'uid', 'username', 'role', 'lastSeenMs', 'joinedAt', 'updatedAt'])
        && data.roomId is string && data.roomId.size() >= 4 && data.roomId.size() <= 64 && data.roomId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 32
        && data.role in ['host', 'guest']
        && data.lastSeenMs is number && data.lastSeenMs >= 0
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWatchPartyMessage(data) {
      return data.keys().hasAll(['roomId', 'uid', 'username', 'text', 'isSuper', 'superCost', 'createdAt'])
        && data.keys().hasOnly(['roomId', 'uid', 'username', 'text', 'isSuper', 'superCost', 'emoji', 'createdAt'])
        && data.roomId is string && data.roomId.size() >= 4 && data.roomId.size() <= 64 && data.roomId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 32
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 240
        && data.isSuper is bool
        && data.superCost is number
        && ((data.isSuper == false && data.superCost == 0) || (data.isSuper == true && data.superCost == 100))
        && (!('emoji' in data) || (data.emoji is string && data.emoji.size() <= 16))
        && data.createdAt is timestamp;
    }

    function isValidWatchPartyReaction(data) {
      return data.keys().hasAll(['roomId', 'uid', 'username', 'emoji', 'isSuper', 'superCost', 'createdAt'])
        && data.keys().hasOnly(['roomId', 'uid', 'username', 'emoji', 'isSuper', 'superCost', 'vipLabel', 'createdAt'])
        && data.roomId is string && data.roomId.size() >= 4 && data.roomId.size() <= 64 && data.roomId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 32
        && data.emoji in ['😂', '😱', '❤️', '🔥', '👑']
        && data.isSuper is bool
        && data.superCost is number
        && ((data.isSuper == false && data.superCost == 0) || (data.isSuper == true && (data.superCost == 100 || data.superCost == 250)))
        && (!('vipLabel' in data) || (data.vipLabel is string && data.vipLabel.size() <= 32))
        && data.createdAt is timestamp;
    }

    function isValidWatchPartySession(data) {
      return data.keys().hasAll(['uid', 'activeRoomId', 'activeRole', 'unlockedRoomIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'activeRoomId', 'activeRole', 'unlockedRoomIds', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.activeRoomId is string && data.activeRoomId.size() <= 64
        && data.activeRole in ['host', 'guest']
        && data.unlockedRoomIds is list && data.unlockedRoomIds.size() <= 20 && (data.unlockedRoomIds.size() == 0 || data.unlockedRoomIds[0] is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Public leaderboard (no PII)
    match /leaderboard/{playerId} {
      allow get: if isSignedIn() && isValidId(playerId) && (resource == null || existing().isPublic == true);
      allow list: if isSignedIn() && existing().isPublic == true;
      allow create: if isOwner(playerId)
        && isValidId(playerId)
        && isValidLeaderboardPlayer(incoming())
        && incoming().uid == request.auth.uid
        && incoming().coins == 0
        && incoming().weeklyCoins == 0
        && incoming().qualified == false
        && incoming().streakCount == 0
        && (!('sundayBonusZar' in incoming()) || incoming().sundayBonusZar == 0)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(playerId) && isValidLeaderboardPlayer(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['coins', 'weeklyCoins', 'qualified', 'streakCount', 'sundayBonusZar', 'username', 'updatedAt'])) ||
          (isOwner(playerId)
            && incoming().coins >= existing().coins - 1000
            && incoming().coins <= existing().coins + 20000
            && incoming().weeklyCoins >= existing().weeklyCoins
            && incoming().weeklyCoins <= existing().weeklyCoins + 20000
            && incoming().diff(existing()).affectedKeys().hasOnly(['coins', 'weeklyCoins', 'qualified', 'streakCount', 'updatedAt'])) ||
          (isOwner(playerId)
            && incoming().coins == 0
            && incoming().weeklyCoins == 0
            && incoming().qualified == false
            && incoming().diff(existing()).affectedKeys().hasOnly(['coins', 'weeklyCoins', 'qualified', 'updatedAt'])) ||
          (isOwner(playerId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'updatedAt'])) ||
          (isOwner(playerId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['trackingId', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(playerId);
    }

    // Private PII & claim records (owner or admin only)
    match /playerPrivate/{playerId} {
      allow get: if isValidId(playerId) && (isOwner(playerId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && isVerified() && existing().uid == request.auth.uid);
      allow create: if isOwner(playerId)
        && isValidId(playerId)
        && isValidPlayerPrivate(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(playerId) && isValidPlayerPrivate(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(playerId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'trackingId',
              'contact',
              'dailyGiftLastClaimed',
              'weekKey',
              'claimedDays',
              'watchedEpisodeIds',
              'lastKeepWatchingDate',
              'lastBannerClaimAt',
              'lastActivityDate',
              'lastMysteryPickDate',
              'updatedAt'
            ]))
        );
      allow delete: if isAdmin() && isValidId(playerId);

      // Private chronological coin earnings & expenditure history
      match /transactions/{transactionId} {
        allow get: if isValidId(playerId) && isValidId(transactionId) && (isOwner(playerId) || isAdmin());
        allow list: if isValidId(playerId) && (isAdmin() || (isSignedIn() && isVerified() && existing().uid == request.auth.uid && playerId == request.auth.uid));
        allow create: if isValidId(playerId)
          && isValidId(transactionId)
          && isValidCoinTransaction(incoming())
          && incoming().uid == playerId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/playerPrivate/$(playerId))
          && (
            isAdmin() ||
            (isOwner(playerId) && incoming().uid == request.auth.uid && incoming().amount >= -1000 && incoming().amount <= 20000)
          );
        allow update, delete: if false;
      }
    }

    // Featured drama series folders (publicly readable catalog; admin-only writes)
    match /series/{seriesId} {
      allow get: if isValidId(seriesId) && (resource == null || existing().isPublic == true);
      allow list: if existing().isPublic == true;
      allow create: if isAdmin()
        && isValidId(seriesId)
        && isValidSeries(incoming())
        && incoming().seriesId == seriesId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(seriesId)
        && isValidSeries(incoming())
        && incoming().seriesId == existing().seriesId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'posterUrl', 'coverImage', 'synopsis', 'episodeIds', 'sortOrder', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(seriesId);
    }

    // Featured short-drama episodes (publicly readable catalog; admin-only writes)
    match /episodes/{episodeId} {
      allow get: if isValidId(episodeId) && (resource == null || existing().isPublic == true);
      allow list: if existing().isPublic == true;
      allow create: if isAdmin()
        && isValidId(episodeId)
        && isValidEpisode(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(episodeId)
        && isValidEpisode(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(episodeId);
    }

    // Global app settings (publicly readable Sponsor Ad URL, embedded ad script, Mystery Vault, pool rollover)
    match /appConfig/{configId} {
      allow get: if isValidId(configId) && (resource == null || existing().isPublic == true);
      allow list: if existing().isPublic == true;
      allow create: if isAdmin()
        && isValidId(configId)
        && isValidAppConfig(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(configId) && isValidAppConfig(incoming())
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isVerified()
            && configId == 'global'
            && incoming().diff(existing()).affectedKeys().hasOnly(['poolPrizeZar', 'r5WinnerUsername', 'nextPickWinsR5', 'updatedAt'])
            && (incoming().poolPrizeZar == existing().poolPrizeZar + 3 || incoming().poolPrizeZar == existing().poolPrizeZar + 5)
            && incoming().r5WinnerUsername == ''
            && incoming().nextPickWinsR5 == false
            && (
              ('nextPickWinsR5' in existing() && existing().nextPickWinsR5 == true) ||
              (
                'r5WinnerUsername' in existing()
                && existing().r5WinnerUsername is string
                && existing().r5WinnerUsername.size() > 0
                && get(/databases/$(database)/documents/leaderboard/$(request.auth.uid)).data.username.lower() == existing().r5WinnerUsername.lower()
              )
            )
          )
        );
      allow delete: if false;
    }

    // R3 Progress Bar Boost Mystery Vault winners (contains PII contact; owner or admin only)
    match /mysteryWinners/{winnerId} {
      allow get: if isValidId(winnerId) && (isAdmin() || (isSignedIn() && existing().uid == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(winnerId)
        && isValidMysteryWinner(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if isAdmin() && isValidId(winnerId);
    }

    // Main Prize & Sunday Pool payout wins (owner or admin only)
    match /prize_wins/{winId} {
      allow get: if isValidId(winId) && (isAdmin() || (isSignedIn() && existing().uid == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(winId)
        && isValidPrizeWin(incoming())
        && incoming().createdAt == request.time
        && (
          isAdmin() ||
          (incoming().uid == request.auth.uid && incoming().createdByUid == request.auth.uid && incoming().status == 'recorded')
        );
      allow update: if isAdmin()
        && isValidId(winId)
        && isValidPrizeWin(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'summary']);
      allow delete: if isAdmin() && isValidId(winId);
    }

    // Player support messages & Claim Prize Help tickets (owner or admin only)
    match /support_messages/{messageId} {
      allow get: if isValidId(messageId) && (isAdmin() || (isSignedIn() && existing().uid == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(messageId)
        && isValidSupportMessage(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(messageId)
        && isValidSupportMessage(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'resolvedBy', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(messageId);
    }

    // Outbound Trigger Email queue addressed strictly to Admin Gmail
    match /mail/{mailId} {
      allow get: if isValidId(mailId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(mailId)
        && isValidMailNotification(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Admin Studio access grants
    match /admins/{uid} {
      allow get: if isSignedIn() && isVerified() && isValidId(uid) && request.auth.uid == uid;
      allow list: if false;
      allow create: if isOwner(uid)
        && isValidId(uid)
        && isValidAdminRecord(incoming())
        && incoming().passcode == 'Gideon_123'
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Verified friend referral visits (visitor creates once; target referrer claims once)
    match /referrals/{visitorId} {
      allow get: if isSignedIn() && isValidId(visitorId) && (
        visitorId == request.auth.uid ||
        (resource != null && (existing().referrerUid == request.auth.uid || existing().visitorUid == request.auth.uid)) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().referrerUid == request.auth.uid ||
        existing().visitorUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(visitorId)
        && visitorId == request.auth.uid
        && isValidReferral(incoming())
        && incoming().visitorUid == request.auth.uid
        && incoming().referrerUid != request.auth.uid
        && incoming().status == 'pending'
        && incoming().rewardCoins == 1000
        && !('claimedAt' in incoming())
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && isValidId(visitorId)
        && isValidReferral(incoming())
        && existing().status == 'pending'
        && incoming().status == 'claimed'
        && existing().referrerUid == request.auth.uid
        && incoming().visitorUid == existing().visitorUid
        && incoming().referrerUid == existing().referrerUid
        && incoming().rewardCoins == existing().rewardCoins
        && incoming().createdAt == existing().createdAt
        && incoming().claimedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedAt']);
      allow delete: if isAdmin() && isValidId(visitorId);
    }

    // Live Synchronized Watch Party Lobbies (authenticated host/guests)
    match /watchParties/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn() && existing().isPublic == true && existing().status == 'active';
      allow create: if isSignedIn()
        && isValidId(roomId)
        && isValidWatchPartyRoom(incoming())
        && incoming().roomId == roomId
        && incoming().hostUid == request.auth.uid
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(roomId)
        && isValidWatchPartyRoom(incoming())
        && existing().hostUid == request.auth.uid
        && incoming().roomId == existing().roomId
        && incoming().hostUid == existing().hostUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'episodeId',
          'episodeTitle',
          'seriesTitle',
          'episodeLabel',
          'category',
          'dailymotionId',
          'videoUrl',
          'coverImage',
          'archiveIdentifier',
          'isPlaying',
          'currentTime',
          'playbackUpdatedAtMs',
          'viewerCount',
          'status',
          'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(roomId) && (existing().hostUid == request.auth.uid || isAdmin());

      // Active participants presence inside a Watch Party room
      match /participants/{participantId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(participantId);
        allow list: if isSignedIn() && isValidId(roomId) && existing().roomId == roomId;
        allow create: if isSignedIn()
          && isValidId(roomId)
          && isValidId(participantId)
          && participantId == request.auth.uid
          && isValidWatchPartyParticipant(incoming())
          && incoming().roomId == roomId
          && incoming().uid == request.auth.uid
          && incoming().joinedAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/watchParties/$(roomId)).data.status == 'active'
          && (
            incoming().role == 'guest' ||
            (incoming().role == 'host' && get(/databases/$(database)/documents/watchParties/$(roomId)).data.hostUid == request.auth.uid)
          );
        allow update: if isSignedIn()
          && isValidId(roomId)
          && isValidId(participantId)
          && participantId == request.auth.uid
          && existing().uid == request.auth.uid
          && isValidWatchPartyParticipant(incoming())
          && incoming().roomId == existing().roomId
          && incoming().uid == existing().uid
          && incoming().role == existing().role
          && incoming().joinedAt == existing().joinedAt
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/watchParties/$(roomId)).data.status == 'active'
          && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'lastSeenMs', 'updatedAt']);
        allow delete: if isSignedIn()
          && isValidId(roomId)
          && isValidId(participantId)
          && (
            existing().uid == request.auth.uid ||
            get(/databases/$(database)/documents/watchParties/$(roomId)).data.hostUid == request.auth.uid ||
            isAdmin()
          );
      }

      // Live chat feed & Gold Highlighted Chat messages (100 Coins)
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId);
        allow list: if isSignedIn() && isValidId(roomId) && existing().roomId == roomId;
        allow create: if isSignedIn()
          && isValidId(roomId)
          && isValidId(messageId)
          && isValidWatchPartyMessage(incoming())
          && incoming().roomId == roomId
          && incoming().uid == request.auth.uid
          && incoming().createdAt == request.time
          && get(/databases/$(database)/documents/watchParties/$(roomId)).data.status == 'active';
        allow update: if false;
        allow delete: if isSignedIn()
          && isValidId(roomId)
          && isValidId(messageId)
          && (
            existing().uid == request.auth.uid ||
            get(/databases/$(database)/documents/watchParties/$(roomId)).data.hostUid == request.auth.uid ||
            isAdmin()
          );
      }

      // Ephemeral floating reactions & Gold Super-Reactions (100 Coins)
      match /reactions/{reactionId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(reactionId);
        allow list: if isSignedIn() && isValidId(roomId) && existing().roomId == roomId;
        allow create: if isSignedIn()
          && isValidId(roomId)
          && isValidId(reactionId)
          && isValidWatchPartyReaction(incoming())
          && incoming().roomId == roomId
          && incoming().uid == request.auth.uid
          && incoming().createdAt == request.time
          && get(/databases/$(database)/documents/watchParties/$(roomId)).data.status == 'active';
        allow update: if false;
        allow delete: if isSignedIn()
          && isValidId(roomId)
          && isValidId(reactionId)
          && (
            existing().uid == request.auth.uid ||
            get(/databases/$(database)/documents/watchParties/$(roomId)).data.hostUid == request.auth.uid ||
            isAdmin()
          );
      }
    }

    // Persisted active Watch Party host/guest session & unlocked room IDs (owner only)
    match /watchPartySessions/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && uid == request.auth.uid;
      allow list: if isSignedIn() && existing().uid == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(uid)
        && uid == request.auth.uid
        && isValidWatchPartySession(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(uid)
        && uid == request.auth.uid
        && isValidWatchPartySession(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['activeRoomId', 'activeRole', 'unlockedRoomIds', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(uid) && uid == request.auth.uid;
    }
  }
}
